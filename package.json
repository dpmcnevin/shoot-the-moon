{
	"name": "shoot-the-moon",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run build:ios-bridge --silent && node --test 'tests/*.test.mjs'",
		"simulate": "node tools/simulate.ts",
		"build:ios-bridge": "esbuild ios/bridge/entry.ts --bundle --format=iife --target=es2022 --outfile=ios/ShootTheMoon/Resources/game-bundle.js",
		"render-audio": "node tools/render-audio.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.0",
		"esbuild": "^0.28.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
